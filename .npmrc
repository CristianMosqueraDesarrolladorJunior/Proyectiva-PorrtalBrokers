# Configuración de registro de dependencias — Portal de Autogestión de Brokers
#
# Gobierno de TI (Seguros Bolívar): todas las dependencias deben descargarse
# EXCLUSIVAMENTE desde el JFrog Artifactory institucional. No usar el registro
# público de npm en entornos corporativos.
#
# Reemplace <jfrog-host> por el host real de Artifactory de la organización.
# NO incluya credenciales, tokens ni secretos en este archivo (deben inyectarse
# vía variables de entorno o el archivo ~/.npmrc del usuario/CI, nunca versionado).
#
# Ejemplo de autenticación por variable de entorno (definir NPM_AUTH_TOKEN en CI):
#   //<jfrog-host>/artifactory/api/npm/npm/:_authToken=${NPM_AUTH_TOKEN}

registry=https://<jfrog-host>/artifactory/api/npm/npm/

# Fijar versiones exactas en toda instalación (prohibido ^, ~, *, latest).
save-exact=true

# Seguridad de cadena de suministro.
audit=true
fund=false
