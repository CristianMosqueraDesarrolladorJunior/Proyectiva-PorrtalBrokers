# Plantilla de configuración de Nginx para servir el SPA de Angular y hacer de
# reverse-proxy del API_Backend. Las variables ${...} se resuelven en el arranque
# del contenedor con `envsubst` (ver docker-entrypoint). Así el destino del backend
# es configurable por variable de entorno sin reconstruir la imagen.
#
# Variables:
#   BACKEND_URL  → URL base del backend (p. ej. http://backend:8080 en docker-compose,
#                  http://host.docker.internal:8080 para un backend en el host, o la URL https
#                  del servicio de Cloud Run del backend).

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Compresión para los estáticos del SPA.
    gzip              on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_vary         on;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/font-woff2;

    # Cabeceras de seguridad base (alineadas con el estándar del equipo).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    server_tokens off;
    # Contrato y documentos del broker: mismo límite que el backend (25 MB por petición).
    client_max_body_size 25m;

    # Reverse-proxy del API_Backend. Preserva la cookie HttpOnly de sesión
    # (withCredentials en el front) y propaga la IP real del cliente.
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        # Cloud Run enruta por Host y exige SNI: se envía el host del backend, no el del front.
        proxy_set_header   Host              $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        # Timeouts alineados con el backend.
        proxy_connect_timeout 15s;
        # La lectura de contratos con Gemini puede tardar hasta 60 s.
        proxy_read_timeout    90s;
    }

    # No cachear el index para que los despliegues se reflejen de inmediato.
    # nginx no hereda add_header en una location que declara los suyos: se repiten las de seguridad.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }

    # Cache agresivo de los assets con hash de contenido.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }

    # SPA fallback: cualquier ruta desconocida sirve index.html (Angular Router).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
