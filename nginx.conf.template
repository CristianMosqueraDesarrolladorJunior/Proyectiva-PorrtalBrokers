# Plantilla de configuración de Nginx para servir el SPA de Angular y hacer de
# reverse-proxy del API_Backend. Las variables ${...} se resuelven en el arranque
# del contenedor con `envsubst` (ver docker-entrypoint). Así el destino del backend
# es configurable por variable de entorno sin reconstruir la imagen.
#
# Variables:
#   BACKEND_URL  → URL base del backend (p. ej. http://backend:8080 en docker-compose,
#                  o http://host.docker.internal:8080 para un backend en el host).

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Compresión para los estáticos del SPA.
    gzip              on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_vary         on;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/font-woff2;

    # Cabeceras de seguridad base (alineadas con el estándar del equipo).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Reverse-proxy del API_Backend. Preserva la cookie HttpOnly de sesión
    # (withCredentials en el front) y propaga la IP real del cliente.
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "";
        # Timeouts alineados con el backend (15s por intento).
        proxy_connect_timeout 15s;
        proxy_read_timeout    30s;
        proxy_cookie_path     / "/; SameSite=Lax";
    }

    # No cachear el index para que los despliegues se reflejen de inmediato.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Cache agresivo de los assets con hash de contenido.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback: cualquier ruta desconocida sirve index.html (Angular Router).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
