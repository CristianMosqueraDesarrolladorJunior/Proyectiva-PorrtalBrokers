{
  "extends": "stylelint-config-standard-scss",
  "rules": {
    "declaration-property-value-disallowed-list": {
      "/^(font-size|font-weight|line-height|padding|padding-top|padding-right|padding-bottom|padding-left|margin|margin-top|margin-right|margin-bottom|margin-left|gap|row-gap|column-gap|border-radius|border-top-left-radius|border-top-right-radius|border-bottom-right-radius|border-bottom-left-radius|box-shadow)$/": [
        "/^(?!.*(var\\(--|\\$)).*(\\d|#|rgb|hsl|em|rem|px|%).*/"
      ]
    },
    "scss/dollar-variable-pattern": null,
    "custom-property-pattern": null,
    "selector-class-pattern": null,
    "selector-pseudo-element-no-unknown": [
      true,
      {
        "ignorePseudoElements": ["ng-deep"]
      }
    ],
    "comment-empty-line-before": null,
    "no-descending-specificity": null,
    "scss/comment-no-empty": null,
    "scss/double-slash-comment-empty-line-before": null,
    "no-empty-source": null,
    "color-function-alias-notation": null,
    "color-function-notation": null,
    "alpha-value-notation": null
  },
  "ignoreFiles": [
    "node_modules/**",
    "dist/**",
    "coverage/**"
  ]
}
